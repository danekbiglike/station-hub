+
+func TestStationHubListenOverride(t *testing.T) {
+	for _, want := range []bool{true, false} {
+		n, _, down := soundSession(t, resolverFunc(func(context.Context, string) (Resolution, error) {
+			return Resolution{Route: "stationhub", Answer: "Готово", Listen: &want}, nil
+		}))
+		n.ShouldListen = !want
+		input := wire.Decode(soundInput("hub-follow-up"), wire.ClientToServer).Client
+		e := input.GetEvent()
+		e.Event = &client.TClientMessage_TEvent_VoiceInput{VoiceInput: e.GetTextInput()}
+		if err := n.Client(t.Context(), websocket.MessageBinary, aa(input)); err != nil {
+			t.Fatal(err)
+		}
+		for {
+			f := nextSoundFrame(t, down)
+			if response := f.Server.GetEvent().GetAliceResponse(); response != nil {
+				if got := response.GetVoiceResponse().GetShouldListen(); got != want {
+					t.Fatalf("listen=%v want %v", got, want)
+				}
+				break
+			}
+		}
+	}
+}
