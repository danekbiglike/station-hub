@@ -68,3 +68,43 @@ func TestProxyRejectsUnavailableUpstreamBeforeUpgrade(t *testing.T) {
 		t.Fatalf("status=%d, want 502", w.Code)
 	}
 }
+
+func TestProxyTracksLiveConnections(t *testing.T) {
+	upstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		c, e := websocket.Accept(w, r, nil)
+		if e != nil {
+			return
+		}
+		defer c.CloseNow()
+		for {
+			if _, _, e = c.Read(r.Context()); e != nil {
+				return
+			}
+		}
+	}))
+	defer upstream.Close()
+	p := &Proxy{Upstream: "ws" + strings.TrimPrefix(upstream.URL, "http") + "/uni.ws"}
+	srv := httptest.NewServer(p)
+	defer srv.Close()
+	ctx, cancel := context.WithTimeout(t.Context(), 5*time.Second)
+	defer cancel()
+	c, _, err := websocket.Dial(ctx, "ws"+strings.TrimPrefix(srv.URL, "http")+"/uni.ws", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	until := time.Now().Add(time.Second)
+	for p.ActiveConnections.Load() != 1 && time.Now().Before(until) {
+		time.Sleep(5 * time.Millisecond)
+	}
+	if got := p.ActiveConnections.Load(); got != 1 {
+		t.Fatalf("active after connect: %d", got)
+	}
+	c.CloseNow()
+	until = time.Now().Add(time.Second)
+	for p.ActiveConnections.Load() != 0 && time.Now().Before(until) {
+		time.Sleep(5 * time.Millisecond)
+	}
+	if got := p.ActiveConnections.Load(); got != 0 {
+		t.Fatalf("active after disconnect: %d", got)
+	}
+}
